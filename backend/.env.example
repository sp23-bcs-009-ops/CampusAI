# ── LLM provider ─────────────────────────────────────────────
# Generated replies use Groq. Put the real key only in .env, never in Git.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI override:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Security ─────────────────────────────────────────────────
# Set a key to require the X-API-Key header on all data endpoints.
# Leave empty during local dev to keep the API open.
CAMPUS_AI_API_KEY=
RATE_LIMIT=20/minute

# ── RAG ──────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db
RAG_TOP_K=4

# ── Rule-based timetable PDF processing and server-side Firestore writes ────
FIREBASE_PROJECT_ID=universityassistentai
# Chat answers read this Firestore project. There is no local timetable fallback.
# Base64-encoded service-account JSON; never commit a real credential.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
TIMETABLE_UPLOAD_MAX_MB=50
# Development only: permits any email-verified Firebase user after ID-token validation.
# Keep false outside local testing.
TIMETABLE_UPLOAD_DEV_MODE=false

# ── Memory ───────────────────────────────────────────────────
MEMORY_WINDOW=8
